{
  "name": "opencode-stm",
  "version": "0.2.0",
  "description": "A session title manager for OpenCode, driven by the agent already working in the conversation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./server": "./dist/src/index.js"
  },
  "files": ["dist/src", "config.example.yaml"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrTralala/opencode-stm.git"
  },
  "homepage": "https://github.com/DrTralala/opencode-stm#readme",
  "bugs": {
    "url": "https://github.com/DrTralala/opencode-stm/issues"
  },
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.35",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
